# Copy to .env and fill in. Bun loads .env automatically.

# Public origin of the app. Passkeys are bound to it.
HUM_ORIGIN=http://localhost:3000
PORT=3000
HUM_DB_PATH=data/hum.sqlite

# One-time secret needed to register the first passkey.
HUM_SETUP_TOKEN=

ANTHROPIC_API_KEY=
HUM_CAPTURE_MODEL=claude-sonnet-5-5
HUM_PLANNING_MODEL=claude-opus-5-5

OPENAI_API_KEY=
HUM_TRANSCRIBE_MODEL=whisper-1

# Used by `bun run add "<task>"` from other folders. Create the token under Settings.
HUM_URL=http://localhost:3000
HUM_API_TOKEN=

# Only needed for the one-time Todoist import.
TODOIST_API_TOKEN=

# Google OAuth client for read-only Calendar access (step 2).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
